# netdisk 服务的 secret 注入文件(6.8 纪律 1:secret 私钥只走 env,永不进 yaml)
#
# 安装:cp deploy/systemd/secrets.env.example /etc/netdisk/secrets.env
#       chown root:netdisk /etc/netdisk/secrets.env && chmod 0640 /etc/netdisk/secrets.env
#       (0640 而不是 0600:Systemd 以 root 读该文件并注入环境,服务进程本身不需要读权限)
#
# 为什么单独一个文件而不是写进 config.yaml:
#   ①yaml 常在工单/聊天里被整份粘贴,secret 混在里面必然扩散;
#   ②yaml 里任何一个键都可能被 `-print-config` 打到日志,而 env 项按纪律被强制脱敏;
#   ③轮换 secret 只需改这一处并 restart,不用碰业务配置(减少"改错一行配置"的机会)。
#
# 本文件**必须入库为 .example**:入库的是"有哪些键",不是"键的值"。
# 真实值由部署时生成,生成命令见各条注释。

# PostgreSQL 口令(必填)。生成建议:openssl rand -base64 24
NETDISK_DB_PASSWORD=change-me

# JWT 签名密钥(必填,校验器强制长度 >= 32 字节)。生成建议:openssl rand -base64 48
# 轮换会让所有已签发令牌失效(客户端需重新登录),因此只在泄露或例行轮换时改。
JWT_SECRET=change-me-at-least-32-bytes-long-random-string

# 以下按部署需要打开(留空/注释掉 = 用 config.yaml 或默认值)

# Redis 口令(E-06 要求服务端配 requirepass)。生成建议:openssl rand -base64 32
# **必须与 redis.conf 里的 requirepass 同值**:两处不同值时服务端表现为
# "登录一律 401/限速全失效",而 Redis 日志里只有一行 NOAUTH —— 很难一眼归因。
# 生产另需在 redis.conf 里:bind 127.0.0.1、appendonly yes、maxmemory-policy noeviction
NETDISK_REDIS_PASSWORD=change-me

# 对象与暂存根目录(生产必须是指定分区,且与 systemd 单元的 ReadWritePaths 一致)
#NETDISK_STORAGE_ROOT=/opt/netdisk/data

# 单次上传/直传上限(字节)
#NETDISK_H5_UPLOAD_MAX_BYTES=104857600
#NETDISK_WEBDAV_PUT_MAX_BYTES=104857600

# 目录级操作走同步事务的行数上限(6.11;超过转异步任务)
#NETDISK_DIR_OP_SYNC_MAX_ROWS=1000

# /metrics 的 Bearer 令牌(抓取端不在本机时必填;留空则只允许回环与可信代理)
#NETDISK_METRICS_TOKEN=change-me
# 运维脚本写的备份/演练状态 JSON(配了才会在 /metrics 暴露备份指标)
#NETDISK_METRICS_BACKUP_STATUS_FILE=/var/lib/netdisk/backup-status.json
